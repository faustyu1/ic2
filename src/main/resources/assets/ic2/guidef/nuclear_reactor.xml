<?xml version="1.0" encoding="UTF-8"?>
<!--
    Laid out as IC2 Classic's reactor window: the grid is only as wide as the chambers built around
    the reactor make it - three columns of its own and one per chamber - and sits in the middle, so
    the full nine by six only shows on a reactor with all six chambers. The heat bar runs under it
    across the width of the inventory, the output beside the inventory label.

    A reactor walled into a full 5x5x5 hull cools with fluid instead of making EU; the coolant
    slots and the two tank gauges belong to that mode and are hidden while it makes EU.
-->
<gui width="176" height="238">
    <text y="6" align="center">%name%</text>
    <slotgrid name="reactor" x="7" y="17" rows="6" maxcols="9" align="center"/>
    <bar name="heat" x="7" y="128" width="162" height="13"/>
    <text x="7" y="131" width="162" center="x" color="0x404040">{ic2.NuclearReactor.gui.heat}</text>
    <text x="8" y="145" color="0x404040">{container.inventory}</text>
    <only if="electric">
        <text x="169" y="145" align="right" color="0x404040">{ic2.NuclearReactor.gui.info.EUoutput|%amount:output%}</text>
    </only>
    <!-- a fluid reactor has no chambers, so its three columns leave room for the coolant on either side -->
    <only if="fluidCooled">
        <slot name="coolantinputSlot" x="7" y="17"/>
        <slot name="coolantoutputSlot" x="7" y="107"/>
        <fluidtank x="10" y="47" name="inputTank" style="borderless"/>
        <slot name="hotcoolinputSlot" x="151" y="17"/>
        <slot name="hotcoolantoutputSlot" x="151" y="107"/>
        <fluidtank x="154" y="47" name="outputTank" style="borderless"/>
    </only>
    <playerInventory x="7" y="155"/>
</gui>
