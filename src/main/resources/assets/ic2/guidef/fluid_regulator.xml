	<button x="102" y="68" width="9" height="9" src="textures/gui/GUIFluidRegulator" u="102" v="68" event="out:-1000"/>
	<button x="112" y="68" width="9" height="9" src="textures/gui/GUIFluidRegulator" u="112" v="68" event="out:-100"/>
	<button x="122" y="68" width="9" height="9" src="textures/gui/GUIFluidRegulator" u="122" v="68" event="out:-10"/>
	<button x="132" y="68" width="9" height="9" src="textures/gui/GUIFluidRegulator" u="132" v="68" event="out:-1"/>
	<button x="151" y="44" width="11" height="9" src="textures/gui/GUIFluidRegulator" u="151" v="44" event="tick"/>
	<button x="151" y="68" width="11" height="9" src="textures/gui/GUIFluidRegulator" u="151" v="68" event="sec"/>

	<playerInventory x="7" y="101" background="false"/>
