<?xml version="1.0" encoding="UTF-8"?>
<!-- 1.12.2 drew this window in code (GuiFluidRegulator/ContainerFluidRegulator); the positions are theirs -->
<gui width="176" height="184">
	<image x="0" y="0" width="176" height="184" src="textures/gui/GUIFluidRegulator"/>
	<text y="6" align="center">%name%</text>

	<energygauge x="12" y="39"/>
	<slot name="discharge" x="8" y="57" style="plain"/>
	<fluidtank name="fluidTank" x="78" y="34"/>
	<slot name="wasserinputSlot" x="58" y="53" style="plain"/>
	<slot name="wasseroutputSlot" x="58" y="71" style="plain"/>

	<text x="105" y="57" color="0x20EB3E">%amount:output%{ic2.generic.text.mb}</text>
