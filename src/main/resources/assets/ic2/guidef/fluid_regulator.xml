		<text x="145" y="57" color="0x20EB3E">{ic2.generic.text.tick}</text>
	</only>
	<only if="tickMode" inverted="true">
		<text x="145" y="57" color="0x20EB3E">{ic2.generic.text.sec}</text>
	</only>

	<button x="102" y="44" width="9" height="9" src="textures/gui/GUIFluidRegulator" u="102" v="44" event="out:1000"/>
