<?xml version="1.0" encoding="UTF-8"?>
<!-- 1.12.2 drew this window in code (GuiCanner/ContainerCanner); the positions are theirs -->
<gui width="176" height="184">
	<image x="0" y="0" width="176" height="184" src="textures/gui/GUICanner"/>
	<text y="6" align="center">%name%</text>

	<!-- the arrows a mode does not use are covered with plain background -->
	<only if="bottleSolid">
		<image x="59" y="53" width="9" height="18" u="3" v="4" src="textures/gui/GUICanner"/>
		<image x="99" y="53" width="18" height="23" u="3" v="4" src="textures/gui/GUICanner"/>
	</only>
	<only if="emptyLiquid">
		<image x="71" y="43" width="26" height="18" u="196" v="0" src="textures/gui/GUICanner"/>
		<image x="59" y="53" width="9" height="18" u="3" v="4" src="textures/gui/GUICanner"/>
	</only>
	<only if="bottleLiquid">
		<image x="99" y="53" width="18" height="23" u="3" v="4" src="textures/gui/GUICanner"/>
		<image x="71" y="43" width="26" height="18" u="196" v="0" src="textures/gui/GUICanner"/>
	</only>

	<gauge name="progress" x="74" y="22" style="progresscanner"/>
	<energygauge x="12" y="62"/>
	<fluidtank x="39" y="42" name="inputTank"/>
	<fluidtank x="117" y="42" name="outputTank"/>

	<slot name="canInput" x="41" y="17" style="plain"/>
	<slot name="input" x="80" y="44" style="plain"/>
	<slot name="output" x="119" y="17" style="plain"/>
	<slot name="discharge" x="8" y="80" style="plain"/>
	<slotgrid name="upgrade" x="152" y="26" cols="1" spacing="2" style="plain"/>

	<!-- the mode switch shows the current mode; a click goes to the next one -->
	<only if="bottleSolid">
		<tooltip text="ic2.Canner.gui.switch.BottleSolid">
			<button x="63" y="81" width="50" height="14" src="textures/gui/GUICanner" u="176" v="18" event="mode"/>
		</tooltip>
	</only>
	<only if="emptyLiquid">
		<tooltip text="ic2.Canner.gui.switch.EmptyLiquid">
			<button x="63" y="81" width="50" height="14" src="textures/gui/GUICanner" u="176" v="32" event="mode"/>
		</tooltip>
	</only>
	<only if="bottleLiquid">
		<tooltip text="ic2.Canner.gui.switch.BottleLiquid">
			<button x="63" y="81" width="50" height="14" src="textures/gui/GUICanner" u="176" v="46" event="mode"/>
		</tooltip>
	</only>
	<only if="enrichLiquid">
		<tooltip text="ic2.Canner.gui.switch.EnrichLiquid">
			<button x="63" y="81" width="50" height="14" src="textures/gui/GUICanner" u="176" v="60" event="mode"/>
		</tooltip>
	</only>
	<tooltip text="ic2.Canner.gui.switchTanks">
		<button x="77" y="64" width="22" height="13" src="textures/gui/GUICanner" u="77" v="64" event="swapTanks"/>
	</tooltip>

	<playerInventory x="7" y="101" background="false"/>
</gui>
