<?xml version="1.0" encoding="UTF-8"?>
<!-- Laid out as IC2 Classic's energy storage window: the armour down the left so a suit can be
     charged without leaving it, the charge and discharge slots with their outlines, the level and
     the output beside them. 1.12.2 drew its own window in code (GuiElectricBlock). -->
<gui width="176" height="166">
	<text y="6" align="center">%name%</text>
	<slot name="charge" x="55" y="16"/>
	<slot name="discharge" x="55" y="52"/>
	<armorslot slot="head" x="7" y="7"/>
	<armorslot slot="chest" x="7" y="25"/>
	<armorslot slot="legs" x="7" y="43"/>
	<armorslot slot="feet" x="7" y="61"/>
	<energygauge x="79" y="38" style="bar"/>
	<text x="79" y="25" color="0x404040">{ic2.EUStorage.gui.info.level}</text>
	<text x="110" y="35" color="0x404040"> %amount:energy%</text>
	<text x="110" y="45" color="0x404040">/%capacity:energy%</text>
	<text x="85" y="60" color="0x404040">{ic2.EUStorage.gui.info.output|%amount:output%}</text>
	<only if="redstone0">
		<tooltip text="ic2.EUStorage.gui.mod.redstone0">
			<button x="152" y="4" width="20" height="20" icon="minecraft:redstone" event="redstone"/>
		</tooltip>
	</only>
	<only if="redstone1">
		<tooltip text="ic2.EUStorage.gui.mod.redstone1">
			<button x="152" y="4" width="20" height="20" icon="minecraft:redstone" event="redstone"/>
		</tooltip>
	</only>
	<only if="redstone2">
		<tooltip text="ic2.EUStorage.gui.mod.redstone2">
			<button x="152" y="4" width="20" height="20" icon="minecraft:redstone" event="redstone"/>
		</tooltip>
	</only>
	<only if="redstone3">
		<tooltip text="ic2.EUStorage.gui.mod.redstone3">
			<button x="152" y="4" width="20" height="20" icon="minecraft:redstone" event="redstone"/>
		</tooltip>
	</only>
	<only if="redstone4">
		<tooltip text="ic2.EUStorage.gui.mod.redstone4">
			<button x="152" y="4" width="20" height="20" icon="minecraft:redstone" event="redstone"/>
		</tooltip>
	</only>
	<only if="redstone5">
		<tooltip text="ic2.EUStorage.gui.mod.redstone5">
			<button x="152" y="4" width="20" height="20" icon="minecraft:redstone" event="redstone"/>
		</tooltip>
	</only>
	<only if="redstone6">
		<tooltip text="ic2.EUStorage.gui.mod.redstone6">
			<button x="152" y="4" width="20" height="20" icon="minecraft:redstone" event="redstone"/>
		</tooltip>
	</only>
	<text x="28" y="73" color="0x404040">{container.inventory}</text>
	<playerInventory x="7" y="83"/>
</gui>
